{
  "name": "peru-ordenado",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "data:geo": "bun scripts/fetch-geo.ts",
    "data:mef": "bun scripts/fetch-mef.ts",
    "data:jev": "env -u AI_GATEWAY_API_KEY bun --env-file=.env.local scripts/classify-projects.ts",
    "data:build": "bun scripts/build-shapes.ts && bun data:layers",
    "data:quipu": "bun scripts/build-quipu.ts",
    "data:territory": "bun scripts/build-territory.ts",
    "data:demonyms": "bun scripts/build-demonyms.ts",
    "data:poblacion": "bun scripts/build-poblacion.ts",
    "data:internet": "bun scripts/build-internet.ts",
    "data:canon": "bun scripts/build-canon.ts",
    "data:layers": "bun data:names && bun data:quipu && bun data:territory && bun data:demonyms && bun data:poblacion && bun data:internet && bun data:canon"
  },
  "packageManager": "bun@1.3.11",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@ai-sdk/gateway": "4.0.100",
    "@biomejs/biome": "2.4.2",
    "@mapbox/geojson-rewind": "^0.5.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "ai": "7.0.122",
    "d3-geo": "^3.1.1",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
